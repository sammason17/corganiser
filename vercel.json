{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "client/dist",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "crons": [
    {
      "path": "/api/cron/precheck",
      "schedule": "0 9 18 * *"
    },
    {
      "path": "/api/cron/settlement",
      "schedule": "0 9 24 * *"
    },
    {
      "path": "/api/cron/monthly-summary",
      "schedule": "0 9 28 * *"
    }
  ],
  "functions": {
    "api/index.js": {
      "memory": 256,
      "maxDuration": 15
    }
  }
}
