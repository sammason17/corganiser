generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash  String   @map("password_hash")
  primaryCardAllowance Float    @default(0) @map("primary_card_allowance")
  createdAt     DateTime @default(now()) @map("created_at")

  weatherPostcode String? @map("weather_postcode")
  weatherLat      Float?  @map("weather_lat")
  weatherLng      Float?  @map("weather_lng")

  // Owned items
  tasks      Task[]
  categories Category[]

  // Activity
  taskUpdates TaskUpdate[]
  timeLogs    TimeLog[]

  // Workout module
  exercises          Exercise[]         @relation("UserExercises")
  exerciseCategories ExerciseCategory[] @relation("UserExerciseCategories")
  bodyAreas          BodyArea[]         @relation("UserBodyAreas")
  workoutPlans       WorkoutPlan[]      @relation("UserWorkoutPlans")

  // DebtFlow module
  debtCards          DebtCard[]         @relation("UserDebtCards")

  // Budget module
  budgetIncomes      BudgetIncome[]     @relation("UserBudgetIncomes")
  budgetCategories   BudgetCategory[]   @relation("UserBudgetCategories")
  budgetSharedBills  BudgetSharedBill[] @relation("UserBudgetSharedBills")
  budgetExpenses     BudgetExpense[]    @relation("UserBudgetExpenses")
  primaryCardRecurring PrimaryCardRecurring[] @relation("UserPrimaryCardRecurring")
  primaryCardGroceryShops PrimaryCardGroceryShop[] @relation("UserPrimaryCardGrocery")
  secondaryCardExpenses SecondaryCardExpense[] @relation("UserSecondaryCardExpenses")

  // Family module
  familyMemberships  FamilyMember[]

  @@map("users")
}

model Task {
  id          String     @id @default(cuid())
  title       String
  description String?
  status      TaskStatus @default(TODO)
  priority    Priority   @default(MEDIUM)
  dueDate     DateTime?  @map("due_date")
  isShared    Boolean    @default(false) @map("is_shared")
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  ownerId String @map("owner_id")
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  familyId String? @map("family_id")
  family   Family? @relation(fields: [familyId], references: [id], onDelete: SetNull)

  categories  TaskCategory[]
  updates     TaskUpdate[]
  timeLogs    TimeLog[]

  @@map("tasks")
}


model Category {
  id          String  @id @default(cuid())
  name        String
  description String?
  color       String  @default("#f59e0b")
  isShared    Boolean @default(false) @map("is_shared")
  createdAt   DateTime @default(now()) @map("created_at")

  ownerId String @map("owner_id")
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  familyId String? @map("family_id")
  family   Family? @relation(fields: [familyId], references: [id], onDelete: SetNull)

  parentId String?    @map("parent_id")
  parent   Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children Category[] @relation("CategoryHierarchy")

  tasks TaskCategory[]

  @@map("categories")
}

// Many-to-many: Task <-> Category
model TaskCategory {
  taskId     String @map("task_id")
  categoryId String @map("category_id")

  task     Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([taskId, categoryId])
  @@map("task_categories")
}

// Append-only notes log per task
model TaskUpdate {
  id        String   @id @default(cuid())
  content   String
  createdAt DateTime @default(now()) @map("created_at")

  taskId String @map("task_id")
  userId String @map("user_id")

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("task_updates")
}

// Time logging per task
model TimeLog {
  id              String   @id @default(cuid())
  durationMinutes Int      @map("duration_minutes")
  description     String?
  loggedAt        DateTime @default(now()) @map("logged_at")

  taskId String @map("task_id")
  userId String @map("user_id")

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("time_logs")
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}

// ── Workout module ────────────────────────────────────────────────────────────

enum DayType {
  UPPER
  LOWER
  FULL_BODY
  CARDIO
  REST
}

model ExerciseCategory {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now()) @map("created_at")

  ownerId String @map("owner_id")
  owner   User   @relation("UserExerciseCategories", fields: [ownerId], references: [id], onDelete: Cascade)

  exercises ExerciseCategoryLink[]

  @@map("exercise_categories")
}

model BodyArea {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now()) @map("created_at")

  ownerId String @map("owner_id")
  owner   User   @relation("UserBodyAreas", fields: [ownerId], references: [id], onDelete: Cascade)

  exercises ExerciseBodyAreaLink[]

  @@map("body_areas")
}

model Exercise {
  id        String   @id @default(cuid())
  name      String
  videoUrl  String?  @map("video_url")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  ownerId String @map("owner_id")
  owner   User   @relation("UserExercises", fields: [ownerId], references: [id], onDelete: Cascade)

  categories          ExerciseCategoryLink[]
  bodyAreas           ExerciseBodyAreaLink[]
  workoutDayExercises WorkoutDayExercise[]

  @@map("exercises")
}

// Many-to-many: Exercise <-> ExerciseCategory
model ExerciseCategoryLink {
  exerciseId String @map("exercise_id")
  categoryId String @map("category_id")

  exercise Exercise         @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  category ExerciseCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([exerciseId, categoryId])
  @@map("exercise_category_links")
}

// Many-to-many: Exercise <-> BodyArea
model ExerciseBodyAreaLink {
  exerciseId String @map("exercise_id")
  bodyAreaId String @map("body_area_id")

  exercise Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  bodyArea BodyArea @relation(fields: [bodyAreaId], references: [id], onDelete: Cascade)

  @@id([exerciseId, bodyAreaId])
  @@map("exercise_body_area_links")
}

model WorkoutPlan {
  id          String   @id @default(cuid())
  name        String
  daysPerWeek Int      @map("days_per_week")
  isActive    Boolean  @default(false) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  ownerId String @map("owner_id")
  owner   User   @relation("UserWorkoutPlans", fields: [ownerId], references: [id], onDelete: Cascade)

  days WorkoutDay[]

  @@map("workout_plans")
}

model WorkoutDay {
  id        String  @id @default(cuid())
  dayNumber Int     @map("day_number")
  label     String?
  dayType   DayType @map("day_type")

  planId String      @map("plan_id")
  plan   WorkoutPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  exercises WorkoutDayExercise[]

  @@map("workout_days")
}

model WorkoutDayExercise {
  id        String @id @default(cuid())
  sortOrder Int    @map("sort_order")

  targetSets   Int?   @map("target_sets")
  targetReps   Int?   @map("target_reps")
  targetWeight Float? @map("target_weight")

  lastSets        Int?      @map("last_sets")
  lastReps        Int?      @map("last_reps")
  lastWeight      Float?    @map("last_weight")
  lastPerformedAt DateTime? @map("last_performed_at")

  dayId      String @map("day_id")
  exerciseId String @map("exercise_id")

  day      WorkoutDay @relation(fields: [dayId], references: [id], onDelete: Cascade)
  exercise Exercise   @relation(fields: [exerciseId], references: [id], onDelete: Cascade)

  @@map("workout_day_exercises")
}

// ── DebtFlow module ────────────────────────────────────────────────────────────

model DebtCard {
  id             String   @id @default(cuid())
  name           String
  totalDebt      Float    @map("total_debt")
  apr            Float
  monthlyPayment Float    @map("monthly_payment")
  paymentDate    Int      @default(1) @map("payment_date")
  statementDate  Int?     @map("statement_date")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  ownerId String @map("owner_id")
  owner   User   @relation("UserDebtCards", fields: [ownerId], references: [id], onDelete: Cascade)

  balanceTransfers BalanceTransfer[]

  @@map("debt_cards")
}

model BalanceTransfer {
  id               String   @id @default(cuid())
  amount           Float
  endDate          DateTime @map("end_date")
  postOfferPayment Float?   @map("post_offer_payment")
  createdAt        DateTime @default(now()) @map("created_at")

  cardId String @map("card_id")
  card   DebtCard @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@map("balance_transfers")
}

// ── Budget module ────────────────────────────────────────────────────────────

model BudgetIncome {
  id        String   @id @default(cuid())
  name      String
  amount    Float
  isSalary  Boolean  @default(false) @map("is_salary")
  createdAt DateTime @default(now()) @map("created_at")

  ownerId String @map("owner_id")
  owner   User   @relation("UserBudgetIncomes", fields: [ownerId], references: [id], onDelete: Cascade)

  @@map("budget_incomes")
}

model BudgetCategory {
  id        String   @id @default(cuid())
  name      String
  color     String   @default("#3b82f6")
  createdAt DateTime @default(now()) @map("created_at")

  ownerId String @map("owner_id")
  owner   User   @relation("UserBudgetCategories", fields: [ownerId], references: [id], onDelete: Cascade)

  expenses    BudgetExpense[]
  sharedBills BudgetSharedBill[]

  @@map("budget_categories")
}

model BudgetSharedBill {
  id        String   @id @default(cuid())
  name      String
  amount    Float
  myShare   Float    @default(0.5) @map("my_share")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")

  categoryId String? @map("category_id")
  category   BudgetCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  ownerId String @map("owner_id")
  owner   User   @relation("UserBudgetSharedBills", fields: [ownerId], references: [id], onDelete: Cascade)

  @@map("budget_shared_bills")
}

model BudgetExpense {
  id            String   @id @default(cuid())
  name          String
  amount        Float
  isPrimaryCard Boolean  @default(false) @map("is_primary_card")
  sortOrder     Int      @default(0) @map("sort_order")
  createdAt     DateTime @default(now()) @map("created_at")

  categoryId String? @map("category_id")
  category   BudgetCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  ownerId String @map("owner_id")
  owner   User   @relation("UserBudgetExpenses", fields: [ownerId], references: [id], onDelete: Cascade)

  @@map("budget_expenses")
}

model PrimaryCardRecurring {
  id              String   @id @default(cuid())
  name            String
  amount          Float
  myPortionAmount Float?   @map("my_portion_amount")
  createdAt       DateTime @default(now()) @map("created_at")

  ownerId String @map("owner_id")
  owner   User   @relation("UserPrimaryCardRecurring", fields: [ownerId], references: [id], onDelete: Cascade)

  @@map("primary_card_recurring")
}

model PrimaryCardGroceryShop {
  id              String   @id @default(cuid())
  name            String   @default("Shop")
  date            DateTime @default(now())
  totalAmount     Float    @map("total_amount")
  myPortionAmount Float    @map("my_portion_amount")
  createdAt       DateTime @default(now()) @map("created_at")

  ownerId String @map("owner_id")
  owner   User   @relation("UserPrimaryCardGrocery", fields: [ownerId], references: [id], onDelete: Cascade)

  @@map("primary_card_grocery_shops")
}

model SecondaryCardExpense {
  id        String   @id @default(cuid())
  name      String
  amount    Float
  createdAt DateTime @default(now()) @map("created_at")

  ownerId String @map("owner_id")
  owner   User   @relation("UserSecondaryCardExpenses", fields: [ownerId], references: [id], onDelete: Cascade)

  @@map("secondary_card_expenses")
}

// ── Family & Households ────────────────────────────────────────────────────────

model Family {
  id         String   @id @default(cuid())
  name       String   @default("My Family")
  inviteCode String   @unique @default(cuid()) @map("invite_code")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  members          FamilyMember[]
  foodShops        SharedFoodShop[]
  exports          SharedStatementExport[]
  state            SharedStatementState?
  automationConfig CardAutomationConfig?
  tasks            Task[]
  categories       Category[]

  @@map("families")
}

model FamilyMember {
  id        String   @id @default(cuid())
  familyId  String   @map("family_id")
  userId    String   @map("user_id")
  role      String   @default("MEMBER") // "OWNER" or "MEMBER"
  createdAt DateTime @default(now()) @map("created_at")

  family    Family   @relation(fields: [familyId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([familyId, userId])
  @@map("family_members")
}

// ── Shared Calculator ─────────────────────────────────────────────────────────

model SharedFoodShop {
  id                 String   @id @default(cuid())
  vendorName         String   @map("vendor_name")
  date               DateTime @default(now())
  totalAmount        Float    @map("total_amount")
  payerName          String   @map("payer_name")
  payerCoveredAmount Float    @map("payer_covered_amount")
  createdAt          DateTime @default(now()) @map("created_at")

  familyId           String?  @map("family_id")
  family             Family?  @relation(fields: [familyId], references: [id], onDelete: Cascade)

  @@map("shared_food_shops")
}

model SharedStatementState {
  id                     String   @id @default(cuid())
  partnerStatementAmount Float    @default(0) @map("partner_statement_amount")
  updatedAt              DateTime @updatedAt @map("updated_at")

  familyId               String?  @unique @map("family_id")
  family                 Family?  @relation(fields: [familyId], references: [id], onDelete: Cascade)

  @@map("shared_statement_state")
}

model SharedStatementExport {
  id                     String   @id @default(cuid())
  name                   String
  partnerStatementAmount Float    @map("partner_statement_amount")
  shopsData              Json     @map("shops_data")
  partnerOwesForMyShops  Float?   @map("partner_owes_for_my_shops")
  iOweForPartnerShops    Float?   @map("i_owe_for_partner_shops")
  finalAmountPartnerOwes Float?   @map("final_amount_partner_owes")
  primaryName            String   @default("Me") @map("primary_name")
  partnerName            String   @default("Partner") @map("partner_name")
  autoExported           Boolean  @default(false) @map("auto_exported")
  isOverridden           Boolean  @default(false) @map("is_overridden")
  overrideReason         String?  @map("override_reason")
  createdAt              DateTime @default(now()) @map("created_at")
  updatedAt              DateTime @updatedAt @default(now()) @map("updated_at")

  familyId               String?  @map("family_id")
  family                 Family?  @relation(fields: [familyId], references: [id], onDelete: Cascade)

  @@unique([familyId, name])
  @@map("shared_statement_exports")
}

model CardAutomationConfig {
  id                         String    @id @default(cuid())
  // Shared Settlement Card (Used strictly for SharedCreditCardStatementCalculator & settlement automation)
  accessToken                String?   @map("access_token")
  refreshToken               String?   @map("refresh_token")
  tokenExpiresAt             DateTime? @map("token_expires_at")
  consentExpiresAt           DateTime? @map("consent_expires_at")
  cardAccountId              String?   @map("card_account_id")
  cardholderName             String?   @map("cardholder_name")
  cardDisplayName            String?   @map("card_display_name")
  supplementaryCardId        String?   @map("supplementary_card_id")

  // Personal Primary Card (For Live Credit Card Budget Monitor)
  primaryAccessToken         String?   @map("primary_access_token")
  primaryRefreshToken        String?   @map("primary_refresh_token")
  primaryTokenExpiresAt      DateTime? @map("primary_token_expires_at")
  primaryConsentExpiresAt    DateTime? @map("primary_consent_expires_at")
  primaryCardAccountId       String?   @map("primary_card_account_id")
  primaryCardholderName      String?   @map("primary_cardholder_name")
  primaryCardDisplayName     String?   @map("primary_card_display_name")
  statementDateType          String    @default("FIXED_DAY") @map("statement_date_type")
  statementDaysBeforePayment Int       @default(14) @map("statement_days_before_payment")
  statementClosingDay        Int       @default(19) @map("statement_closing_day")
  paymentDueDay              Int       @default(1) @map("payment_due_day")
  lastStatementAmount        Float     @default(0) @map("last_statement_amount")
  primaryLastKnownBalance    Float     @default(0) @map("primary_last_known_balance")

  // Personal Secondary Card (For Live Credit Card Budget Monitor)
  secondaryAccessToken       String?   @map("secondary_access_token")
  secondaryRefreshToken      String?   @map("secondary_refresh_token")
  secondaryTokenExpiresAt    DateTime? @map("secondary_token_expires_at")
  secondaryConsentExpiresAt  DateTime? @map("secondary_consent_expires_at")
  secondaryCardAccountId     String?   @map("secondary_card_account_id")
  secondaryCardholderName    String?   @map("secondary_cardholder_name")
  secondaryCardDisplayName   String?   @map("secondary_card_display_name")
  secondaryStatementDateType String    @default("FIXED_DAY") @map("secondary_statement_date_type")
  secondaryStatementDaysBeforePayment Int @default(14) @map("secondary_statement_days_before_payment")
  secondaryStatementClosingDay Int     @default(19) @map("secondary_statement_closing_day")
  secondaryPaymentDueDay     Int       @default(1) @map("secondary_payment_due_day")
  secondaryLastStatementAmount Float   @default(0) @map("secondary_last_statement_amount")
  secondaryLastKnownBalance  Float     @default(0) @map("secondary_last_known_balance")

  lastKnownStatementDate     String?   @map("last_known_statement_date")
  lastProcessedStatementDate String?   @map("last_processed_statement_date")
  lastPrecheckSentMonth      String?   @map("last_precheck_sent_month")

  isActive                   Boolean   @default(false) @map("is_active")
  lastSyncAt                 DateTime? @map("last_sync_at")
  lastSyncStatus             String?   @map("last_sync_status")
  lastSyncMessage            String?   @map("last_sync_message")

  familyId                   String?   @unique @map("family_id")
  family                     Family?   @relation(fields: [familyId], references: [id], onDelete: Cascade)

  createdAt                  DateTime  @default(now()) @map("created_at")
  updatedAt                  DateTime  @updatedAt @map("updated_at")

  @@map("card_automation_config")
}
